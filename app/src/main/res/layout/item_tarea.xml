<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:paddingTop="50dp">

    <TextView
        android:id="@+id/tvTarea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp"
        android:paddingTop="40dp"
        android:textSize="24sp" />

    <CheckBox
        android:id="@+id/cbRealizada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:contentDescription="Marcar como realizada" />

    <!-- Botón Editar con Button -->
    <Button
        android:id="@+id/btnEditar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:drawableBottom="@android:drawable/ic_menu_edit"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/white"
        app:drawableTint="@android:color/black" />

    <!-- Botón Borrar con Button -->
    <Button
        android:id="@+id/btnBorrar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:drawableBottom="@android:drawable/ic_menu_delete"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/white"
        app:drawableTint="@android:color/black" />

</LinearLayout>